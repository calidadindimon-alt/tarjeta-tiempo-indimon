rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Un admin es alguien cuyo UID de Firebase Auth tiene un documento en /admins/
    function esAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ENDURECIDO (auditoría 20/09, ronda 2 — Crítico #2): las reglas de Firestore no pueden
    // reproducir calcularJornadaDiaria() (esa lógica vive solo en el cliente), así que no hay forma
    // de verificar en el servidor que las horas escritas correspondan exactamente a la entrada/salida
    // real. Lo que SÍ se puede y se debe exigir es que el resultado sea FÍSICAMENTE posible: nadie
    // trabaja más de 24 horas en un mismo día y ningún campo de horas es negativo. Esto no valida que
    // el número sea el CORRECTO, pero cierra el caso concreto encontrado en la auditoría (un
    // colaborador escribiendo, por ejemplo, horas_extras_nocturnas: 60 en su propio registro).
    //
    // BUG CORREGIDO (auditoría 20/09, ronda 3): la primera versión de esta función exigía
    // "dom <= ord", asumiendo que las horas dominicales/festivas son siempre un subconjunto de las
    // ordinarias. Eso es FALSO: calcularJornadaDiaria() también marca como dominicales las horas
    // EXTRA trabajadas un domingo/festivo (Art. 179 CST: el recargo dominical es acumulable con el de
    // horas extra), así que en un turno largo de domingo horas_dominicales puede superar a
    // horas_ordinarias con toda razón. Con la regla vieja, un colaborador que de verdad trabajara
    // extra un domingo habría visto su propio fichaje legítimo rechazado por el servidor
    // (permission-denied), sin haber hecho nada malo. Ahora "dom" se compara contra el total FÍSICO
    // de horas trabajadas ese día (ord + extD + extN, que es lo único de lo que "dom" puede ser
    // subconjunto), y "recNoct" se compara contra "ord" (el recargo nocturno ORDINARIO sí es siempre
    // un subconjunto de las horas ordinarias, eso no cambió). Se deja un margen de 0.02 para el
    // redondeo de dos decimales que ya aplica calcularJornadaDiaria().
    function horasDiaCoherentes() {
      let d = request.resource.data;
      let ord = d.get('horas_ordinarias', 0);
      let extD = d.get('horas_extras_diurnas', 0);
      let extN = d.get('horas_extras_nocturnas', 0);
      let recNoct = d.get('horas_recargo_nocturno', 0);
      let dom = d.get('horas_dominicales', 0);
      let totalFisico = ord + extD + extN;
      return ord >= 0 && extD >= 0 && extN >= 0 && recNoct >= 0 && dom >= 0 &&
             totalFisico <= 24 && recNoct <= (ord + 0.02) && dom <= (totalFisico + 0.02);
    }

    // ENDURECIDO (auditoría 20/09, ronda 4): "Eliminar Colaborador" en el panel Admin marca
    // activo:false y borra empleados_publico/{cedula} — eso bloquea el LOGIN normal (el buscador de
    // nombres ya no lo encuentra), pero su cuenta de Firebase Authentication (el PIN) sigue existiendo
    // tal cual, y el authUid guardado en empleados/{cedula} nunca se borra. La propia app ya avisa de
    // esto en el mensaje de confirmación ("si ya había creado su PIN, elimínalo también a mano en
    // Firebase Authentication"), pero mientras eso no se haga a mano, alguien despedido que YA se
    // había registrado con PIN podía seguir autenticándose directo contra Firebase (sin pasar por la
    // pantalla de la app) y, con las reglas de más abajo, seguir fichando/cambiando su sueldo como si
    // nada. Esta función cierra ese hueco a nivel de reglas: además de que el authUid coincida, exige
    // que el documento de empleados NO esté marcado activo:false.
    // APROBACIÓN DE HORAS EXTRA (RRHH): un colaborador solo puede dejar sus horas extra "por aprobar"
    // (al marcar la salida) o no tocar el estado. Aprobarlas o marcarlas como no autorizadas, y firmar
    // esa decisión (extras_revisada_por / extras_revisada_en), solo lo puede hacer Admin. Sin esto, desde la
    // consola del navegador un colaborador podría escribir extras_estado: 'aprobada' en su propio día.
    function extrasEstadoPermitidoColaborador() {
      let nuevo = request.resource.data;
      let estadoOk = nuevo.get('extras_estado', null) == null ||
        nuevo.get('extras_estado', null) == 'por_aprobar' ||
        (resource != null && resource.data.get('extras_estado', null) == nuevo.get('extras_estado', null));
      let firmaOk = (resource == null && nuevo.get('extras_revisada_por', null) == null && nuevo.get('extras_revisada_en', null) == null) ||
        (resource != null && resource.data.get('extras_revisada_por', null) == nuevo.get('extras_revisada_por', null) &&
                             resource.data.get('extras_revisada_en', null) == nuevo.get('extras_revisada_en', null));
      return estadoOk && firmaOk;
    }

    // SALIDAS A CITA O PERMISO (nov-2026): la decisión de RRHH sobre un permiso personal (no se descuenta / se descuenta /
    // se repone) vive en decisiones_permiso del registro del día. Solo Admin la escribe: el colaborador sigue guardando su
    // propio registro (salir, volver, marcar "Entendido" en decisiones_vistas), pero sin poder tocar esa decisión.
    function decisionesPermisoSinCambio() {
      return request.resource.data.get('decisiones_permiso', null) ==
             (resource == null ? null : resource.data.get('decisiones_permiso', null));
    }

    // ============ CANDADOS DEL COLABORADOR SOBRE SU PROPIO DÍA (auditoría nov-2026, hallazgo 3) ============
    // Las horas las calcula el celular y el servidor no puede repetir ese cálculo. Hasta ahora solo se exigía que fueran
    // "posibles" (máximo 24 y no negativas), así que con la consola del navegador un colaborador podía, en su propio
    // registro: subir las extras de un día que RRHH ya aprobó, inventarse horas dominicales en un martes, crear días
    // pasados o domingos sin fichar, quitarse una ausencia injustificada, autorizarse la entrada temprana, aprobarse un
    // día "por revisar" o borrar las horas de un permiso que RRHH decidió descontar. Lo que sigue cierra eso sin cambiar
    // nada de lo que la app hace normalmente desde el celular:
    //   - Un día nuevo solo nace como turno abierto, sin horas y con fecha de hoy (con margen para fichajes sin señal).
    //   - Mientras el turno está abierto, el celular marca almuerzo, salidas a permiso y la salida, pero no cambia la
    //     entrada ni los datos que pone Admin (tipo de permiso, entrada temprana autorizada…).
    //   - Un día cerrado ("completado") solo se puede recalcular (las horas), nunca cambiar de horario ni de estado.
    //   - Un día "por revisar" solo lo toca Admin.
    //   - Las horas trabajadas no pueden pasar de lo que hay entre la entrada y la salida.
    //   - Las horas dominicales solo caben en sábado (turno que entra al domingo), domingo, festivo o víspera de festivo.
    //   - Si cambian las horas extra, vuelven a "por aprobar" (también las ya aprobadas y las de antes del 21-oct-2026).
    //   - Si RRHH ya decidió sobre una salida a permiso, el colaborador no cambia esas horas de permiso.
    // Lo que NO cierra (necesita un servidor propio): la hora que marca el celular sigue siendo la del celular.

    // Calendario nacional, copiado de FESTIVOS_COLOMBIA en index.html (2026–2028). Si se agrega un año allá, agregarlo
    // aquí. Los festivos que Admin agrega a mano (catálogo) también cuentan (ver esFestivo). Va como UN texto separado
    // por comas y no como lista: Firestore cuenta cada elemento de una lista escrita aquí como una expresión, y cada
    // escritura tiene un tope de 1000.
    function festivosNacionales() {
      return ('2026-01-01,2026-01-12,2026-03-23,2026-04-02,2026-04-03,2026-05-01,2026-05-18,2026-06-08,2026-06-15,' +
              '2026-06-29,2026-07-20,2026-08-07,2026-08-17,2026-10-12,2026-11-02,2026-11-16,2026-12-08,2026-12-25,' +
              '2027-01-01,2027-01-11,2027-03-22,2027-03-25,2027-03-26,2027-05-01,2027-05-10,2027-05-31,2027-06-07,' +
              '2027-07-05,2027-07-20,2027-08-07,2027-08-16,2027-10-18,2027-11-01,2027-11-15,2027-12-08,2027-12-25,' +
              '2028-01-01,2028-01-10,2028-03-20,2028-04-13,2028-04-14,2028-05-01,2028-05-29,2028-06-19,2028-06-26,' +
              '2028-07-03,2028-07-20,2028-08-07,2028-08-21,2028-10-16,2028-11-06,2028-11-13,2028-12-08,2028-12-25').split(',');
    }

    function fechaValida(fecha) {
      return fecha is string && fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function tsDeFecha(fecha) {
      let p = fecha.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    function dosDigitos(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }
    function textoDeFecha(t) {
      return string(t.year()) + '-' + dosDigitos(t.month()) + '-' + dosDigitos(t.day());
    }
    function esFestivo(fecha) {
      return fecha in festivosNacionales() ||
        (exists(/databases/$(database)/documents/catalogos/listas) &&
         fecha in get(/databases/$(database)/documents/catalogos/listas).data.get('festivos', []));
    }
    // dayOfWeek(): 1 = lunes … 6 = sábado, 7 = domingo.
    function puedeTenerHorasDominicales(fecha) {
      let t = tsDeFecha(fecha);
      return t.dayOfWeek() >= 6 || esFestivo(fecha) || esFestivo(textoDeFecha(t + duration.value(1, 'd')));
    }
    // El día es de hoy en Colombia, con margen: hasta 3 días atrás (un fichaje que se guardó sin señal y se envió
    // después) y 1 adelante (diferencia de hora con el servidor).
    function fechaCercanaAHoy(fecha) {
      let t = tsDeFecha(fecha);
      return request.time > t - duration.value(1, 'd') && request.time < t + duration.value(4, 'd');
    }

    function horaValida(h) {
      return h is string && h.matches('^[0-9]{1,2}:[0-9]{2}(:[0-9]{2})?$');
    }
    function horaDecimal(h) {
      let p = h.split(':');
      return float(int(p[0])) + float(int(p[1])) / 60.0;
    }
    // Igual que calcularJornadaDiaria: si la salida es menor que la entrada, el turno pasó la medianoche.
    function duracionDelTurno(entrada, salida) {
      let ini = horaDecimal(entrada);
      let fin = horaDecimal(salida);
      return fin < ini ? fin - ini + 24.0 : fin - ini;
    }
    function horasDentroDelTurno(d) {
      let total = d.get('horas_ordinarias', 0) + d.get('horas_extras_diurnas', 0) + d.get('horas_extras_nocturnas', 0);
      return total <= 0 ||
        (horaValida(d.get('entrada', null)) && horaValida(d.get('salida', null)) &&
         total <= duracionDelTurno(d.entrada, d.salida) + 0.05);
    }
    function horasEnCero(d) {
      return d.get('horas_ordinarias', 0) == 0 && d.get('horas_extras_diurnas', 0) == 0 &&
             d.get('horas_extras_nocturnas', 0) == 0 && d.get('horas_recargo_nocturno', 0) == 0 &&
             d.get('horas_dominicales', 0) == 0;
    }
    function dominicalesCoherentes(d, fecha) {
      return (d.get('horas_dominicales', 0) == 0 && d.get('es_dominical_festivo', false) != true) ||
             puedeTenerHorasDominicales(fecha);
    }
    function sinCambio(campo) {
      return request.resource.data.get(campo, null) == (resource == null ? null : resource.data.get(campo, null));
    }
    // Si cambian las horas extra (o aparecen), quedan "por aprobar": RRHH aprueba la cifra nueva.
    function extrasCambiadasVuelvenAPorAprobar() {
      let n = request.resource.data;
      let antesD = resource == null ? 0 : resource.data.get('horas_extras_diurnas', 0);
      let antesN = resource == null ? 0 : resource.data.get('horas_extras_nocturnas', 0);
      let cambian = n.get('horas_extras_diurnas', 0) != antesD || n.get('horas_extras_nocturnas', 0) != antesN;
      return !cambian || n.get('horas_extras_diurnas', 0) + n.get('horas_extras_nocturnas', 0) <= 0 ||
             n.get('extras_estado', null) == 'por_aprobar';
    }
    // Datos que solo pone Admin (o la sincronización de un permiso aprobado, que tiene su propia rama más abajo).
    function camposDeAdminSinCambio() {
      return sinCambio('entrada_temprana_autorizada') && sinCambio('permiso_id') && sinCambio('dias_vacaciones_permiso') &&
             sinCambio('revision_aprobada_por') && sinCambio('revision_aprobada_en');
    }
    function permisoDelDiaSinCambio() {
      return sinCambio('tipo_permiso') && sinCambio('horas_permiso') && sinCambio('nota_permiso');
    }
    // La app quita la marca de ausencia cuando la persona SÍ llega y marca entrada ese día (ver registrarEvento).
    function ausenciaQuitadaAlLlegar() {
      let n = request.resource.data;
      return resource.data.get('tipo_permiso', '') is string && resource.data.get('tipo_permiso', '').matches('.*Ausencia.*') &&
             n.get('tipo_permiso', null) == null && n.get('horas_permiso', 0) == 0 && n.get('nota_permiso', null) == null;
    }
    // Con la decisión de RRHH ya tomada sobre una salida a permiso de un día cerrado, sus horas no cambian.
    function permisoTurnoSinCambioSiRrhhDecidio() {
      return resource == null || resource.data.get('estado', null) == 'activo' ||
             !(resource.data.get('decisiones_permiso', null) is map) ||
             resource.data.get('decisiones_permiso', {}).size() == 0 ||
             sinCambio('horas_permiso_turno');
    }
    // Lo común a toda escritura del colaborador sobre su propio día.
    function escrituraColaboradorCoherente(cedula, fecha) {
      let d = request.resource.data;
      return esColaboradorActivoAutenticado(cedula) && fechaValida(fecha) && d.get('fecha', fecha) == fecha &&
             horasDiaCoherentes() && extrasEstadoPermitidoColaborador() && decisionesPermisoSinCambio() &&
             camposDeAdminSinCambio() && horasDentroDelTurno(d) && dominicalesCoherentes(d, fecha) &&
             extrasCambiadasVuelvenAPorAprobar() && permisoTurnoSinCambioSiRrhhDecidio();
    }
    // Lo que cambia "Recalcular semana" (recalcularSemana en index.html), que también corre en el celular al cerrar el día.
    function soloCamposDeRecalculo() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'horas_ordinarias', 'horas_extras_diurnas', 'horas_extras_nocturnas', 'horas_recargo_nocturno',
        'es_dominical_festivo', 'horas_dominicales', 'minutos_tarde', 'horas_descuento_tardanza',
        'horas_permiso_turno', 'extras_estado']);
    }

    // PRIVACIDAD (30/10): ¿quien pregunta es el colaborador dueño de esta cédula? Igual que en las escrituras, se
    // compara el usuario de Firebase con el authUid guardado en su ficha (no basta con el correo emp{cédula}@…, porque
    // cualquiera podría crear esa cuenta para alguien que todavía no tiene PIN). Una cédula vacía o inexistente es "no".
    function esDuenoDe(cedula) {
      return request.auth != null && cedula is string && cedula != '' &&
             exists(/databases/$(database)/documents/empleados/$(cedula)) &&
             get(/databases/$(database)/documents/empleados/$(cedula)).data.get('authUid', null) == request.auth.uid;
    }

    function esColaboradorActivoAutenticado(cedula) {
      let emp = get(/databases/$(database)/documents/empleados/$(cedula)).data;
      return request.auth != null &&
             emp.authUid == request.auth.uid &&
             emp.get('activo', true) != false;
    }

    // ENDURECIDO (auditoría 27/09, ronda 5 — Crítico #3): la rama de "permiso sin horas" de
    // /empleados/{cedula}/registros/{fecha} (usada por sincronizarPermisoConNomina() cuando un
    // permiso aprobado no tiene un registro de tiempo real ese día) solo exigía que las horas
    // fueran cero — sin ningún otro chequeo, ni siquiera request.auth != null. Eso permitía a
    // cualquiera, incluso sin autenticarse y usando solo la API pública de Firestore, crear (o
    // en 'update', modificar) un registro de "ausencia" para CUALQUIER cédula, con cualquier
    // tipo_permiso/nota, sin que existiera ningún permiso real aprobado detrás. Ahora esa rama
    // exige permiso_id apuntando a un documento real en /permisos/ que (a) pertenece a esa misma
    // cédula y (b) está en estado 'aprobado' — así el registro solo puede reflejar un permiso que
    // de verdad se aprobó, para el colaborador correcto.
    function permisoAprobadoValido(permisoId, cedula) {
      return permisoId != null &&
             get(/databases/$(database)/documents/permisos/$(permisoId)).data.trabajador_cedula == cedula &&
             get(/databases/$(database)/documents/permisos/$(permisoId)).data.estado == 'aprobado';
    }

    // ENDURECIDO (auditoría 27/09, ronda 5 — Crítico #3, parte 2): lo anterior verifica que el
    // permiso referenciado esté 'aprobado', pero esa palabra no valía nada si /permisos/ permitía
    // crear un documento YA con estado:'aprobado' desde el primer escrito (sin haber pasado por
    // ninguna firma). Ahora un permiso SIEMPRE debe nacer sin estado 'aprobado' (create, más abajo),
    // y solo puede llegar a 'aprobado' vía update si el propio documento que se está guardando
    // muestra que los 4 roles (trabajador/jefe/supervisor/rrhh) ya tienen firmado:true. Esto no
    // verifica la IDENTIDAD de quien firmó cada rol (eso requeriría una Cloud Function, fuera del
    // alcance de reglas de Firestore — ya señalado en la nota de /permisos/ más abajo); lo que sí
    // logra es que "aprobado" ya no se pueda alcanzar con una sola escritura arbitraria, sino que
    // exija reproducir la estructura completa de las 4 firmas.
    // Copia de los tipos de PERMISOS_CATALOGO en index.html: si se agrega un tipo allá, agregarlo aquí. Va como un texto
    // separado por ";" (no como lista; split() usa expresiones regulares y "|" ahí significa "o") por el tope de 1000 expresiones de Firestore (ver festivosNacionales).
    function tiposDePermisoValidos() {
      return ('Cita médica (urgencia o especialista);Calamidad doméstica;Diligencia judicial/entidad pública;' +
              'Obligación escolar (acudiente);Votación o jurado de votación;Comisión sindical o entierro de compañero;' +
              'Licencia por luto (familiar cercano);Licencia por matrimonio;Día libre por ir en bicicleta (transporte sostenible);' +
              'Permiso personal (según política interna);Licencia no remunerada (art. 51 CST);' +
              'Permiso no contemplado en la ley (Reglamento Interno);Vacaciones').split(';');
    }

    function permisoTieneLas4Firmas() {
      let f = request.resource.data.firmantes;
      return f.trabajador.firmado == true &&
             f.jefe.firmado == true &&
             f.supervisor.firmado == true &&
             f.rrhh.firmado == true;
    }

    // -------------------------------------------------------------------------
    // REGISTROS DE TIEMPO (consulta "collection group"): el panel Admin, cuando
    // NO filtras por un colaborador específico, lee los registros de TODOS los
    // colaboradores a la vez con una consulta especial de Firestore que junta
    // todas las subcolecciones "registros" (de cualquier colaborador) en una
    // sola búsqueda. Esa consulta especial necesita su PROPIA regla aparte —
    // la regla anidada dentro de /empleados/{cedula}/registros/{fecha} de más
    // abajo NO le aplica automáticamente (es una particularidad de Firestore).
    // Sin este bloque, la tabla de "Todos los colaboradores" del Consolidado
    // de Tiempos falla con "Error de permisos o conexión".
    //
    // ENDURECIDO (auditoría 20/09, H1): la escritura aquí queda en "false" a
    // propósito — la app NUNCA escribe usando esta forma de "collection group"
    // (siempre escribe con la ruta completa empleados/{cedula}/registros/{fecha},
    // que es la que de verdad manda: ver más abajo). Este bloque solo necesita
    // permitir la LECTURA agregada; dejar su escritura en "true" —como estaba—
    // era una puerta de escritura sin ningún control que nadie usaba mal
    // aposta, pero tampoco hacía falta dejar abierta.
    // -------------------------------------------------------------------------
    // PRIVACIDAD (30/10): esta consulta trae los registros de TODOS (horas, GPS, selfies): solo Admin. Mi Tarjeta lee
    // los suyos por la ruta normal (más abajo), nunca con esta consulta.
    match /{path=**}/registros/{fecha} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // ADMINS: solo un admin ya autenticado puede leer la lista de admins
    // (necesario para el propio chequeo de esAdmin()). Nadie puede crear admins
    // desde la app — eso se hace a mano desde la consola de Firebase.
    // -------------------------------------------------------------------------
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // EMPLEADOS: cada colaborador necesita poder leer su propio documento para
    // entrar a "Mi Tarjeta" (sin Firebase Auth real, ver limitación arriba).
    // Escritura: un admin puede cambiar cualquier campo (agregar/editar/eliminar
    // colaboradores). Sin ser admin, solo se permite actualizar el campo de
    // salario/tarifa (lo que hace el propio colaborador desde "Mi Tarjeta"),
    // nunca nombre, cargo, cédula o tipo de vinculación.
    //
    // ENDURECIDO (auditoría 20/09, ronda 2 — Crítico #1): esta rama "sin ser admin" solo exigía que
    // los campos cambiados fueran sueldo_base/tarifa_hora, pero nunca verificaba QUIÉN escribía — le
    // faltó el mismo candado de authUid que sí tiene 'registros'. Con eso, cualquiera con la consola
    // del navegador podía ejecutar updateDoc sobre la cédula de OTRO colaborador y cambiarle el
    // sueldo. Ahora, sin ser Admin, además de limitar los campos, se exige que el authUid del
    // documento (resource.data, el que YA existe en el servidor) coincida con quien está autenticado
    // — igual que en 'registros'.
    // -------------------------------------------------------------------------
    // PRIVACIDAD (30/10): la ficha completa trae el sueldo/tarifa: solo Admin o el propio colaborador. El cargo y el saldo
    // de vacaciones, que sí necesitan el formulario de permisos y la constancia sin sesión, se copian a empleados_publico.
    match /empleados/{cedula} {
      allow read: if esAdmin() ||
        (request.auth != null && resource.data.get('authUid', null) == request.auth.uid);
      allow create, delete: if esAdmin();
      // ENDURECIDO (ronda 4): se agrega "resource.data.get('activo', true) != false" — si Admin ya
      // marcó a este colaborador como inactivo (eliminado), ya no puede tocar ni su propio sueldo,
      // sin depender de que alguien se acuerde de borrar también su cuenta en Firebase Authentication.
      //
      // BUG CORREGIDO (soporte, 22/09): esta regla se olvidó del PRIMER guardado del PIN. Cuando un
      // colaborador crea su PIN por primera vez (o cuando la app repara un authUid que se quedó a
      // medias, ver el catch de 'auth/email-already-in-use' en el login), el código necesita escribir
      // SU PROPIO authUid en este documento — pero la única rendija que existía para "no-admin" exigía
      // que el ÚNICO campo cambiado fuera sueldo_base/tarifa_hora, así que esa escritura de authUid
      // quedaba rechazada con permission-denied, y la app lo mostraba como "Tu sesión ya no es válida"
      // incluso para gente entrando por primera vez o cuyo PIN nunca terminó de vincularse (caso real:
      // Doris, 22/09). Se agrega una rama nueva: solo cuando el documento TODAVÍA no tiene authUid
      // (nadie se lo puede robar a alguien que ya tiene uno vinculado), el único campo que cambia es
      // authUid, y el valor que se escribe es exactamente el UID de quien está autenticado (no puede
      // escribir el UID de otra persona).
      allow update: if esAdmin() ||
        (request.auth != null &&
         resource.data.get('authUid', null) == null &&
         resource.data.get('activo', true) != false &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid']) &&
         request.resource.data.authUid == request.auth.uid) ||
        (request.auth != null &&
         resource.data.authUid == request.auth.uid &&
         resource.data.get('activo', true) != false &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['sueldo_base', 'tarifa_hora']));

      match /registros/{fecha} {
        // PRIVACIDAD (30/10): horas, ubicación GPS y selfies: solo Admin o el dueño.
        allow read: if esAdmin() || esDuenoDe(cedula);

        // ENDURECIDO (auditoría 20/09, H1): esto era "allow write: if true" — con las credenciales
        // públicas de Firebase, cualquiera podía escribir horas fabricadas (extras, dominicales, etc.)
        // para sí mismo o para OTRO colaborador, sin pasar por la app ni por la pantalla de PIN. Ahora
        // quien escribe debe ser una de estas tres cosas:
        //   1. Admin (esAdmin()).
        //   2. El propio colaborador autenticado — su UID de Firebase Auth coincide con el authUid
        //      guardado en empleados/{cedula} (ver la nota de "PIN" al inicio del archivo) — para su
        //      propio fichaje de entrada/salida/almuerzo.
        //   3. La sincronización de un permiso aprobado por firma remota (SIN login, a propósito — ver
        //      /permisos/ más abajo): en creación, solo si las horas trabajadas quedan en cero (un
        //      permiso nunca debe inventar horas de un turno real) Y el permiso_id referenciado
        //      corresponde a un permiso real, aprobado, de este mismo colaborador (ver ronda 5); en
        //      actualización, solo si los ÚNICOS campos que cambian son los informativos del permiso
        //      (tipo/horas/nota/días de vacaciones/permiso_id), con la misma verificación.
        //
        // ENDURECIDO (auditoría 20/09, ronda 2 — Crítico #2): la rama 2 (el propio colaborador
        // autenticado) dejaba escribir CUALQUIER valor en los campos de horas — un colaborador técnico
        // podía, desde la consola del navegador, escribir horas_extras_nocturnas: 60 en su propio
        // registro y esas horas se liquidaban, sin ninguna validación del servidor. Ahora esa rama
        // exige además horasDiaCoherentes() (ver función arriba): valores no negativos y un total por
        // día que no supere lo físicamente posible en 24 horas.
        //
        // ENDURECIDO (ronda 4): se reemplaza el chequeo suelto de authUid por
        // esColaboradorActivoAutenticado(cedula), que además exige que el colaborador NO esté marcado
        // activo:false — así "Eliminar Colaborador" corta también la capacidad de fichar, no solo el
        // login por la pantalla normal de la app (ver la nota de la función).
        //
        // ENDURECIDO (ronda 5): ver permisoAprobadoValido() — la rama 3 ya no acepta cualquier
        // registro con horas en cero, exige que exista un permiso real aprobado detrás.
        //
        // ENDURECIDO (auditoría nov-2026, hallazgo 3): la rama 2 exige además los candados de arriba
        // (escrituraColaboradorCoherente) y solo deja estos cambios de estado — ver la nota junto a esos candados.
        //
        // ORDEN A PROPÓSITO: Firestore corta cada escritura en 1000 expresiones evaluadas, y los candados del colaborador
        // son largos. Cuando no se cumplen, el emulador muestra que se llega a ese tope. Por eso las ramas cortas (Admin,
        // permiso aprobado, "Entendido") van ANTES: si fueran después, el tope podría rechazar una escritura que sí
        // cumplía su rama. Y la rama del colaborador empieza por request.auth != null, que descarta enseguida a
        // quien no tiene sesión.
        //
        // ENDURECIDO (auditoría nov-2026, hallazgo 4): se cierra la rama 3 (sincronizar un permiso aprobado SIN sesión).
        // Con las credenciales públicas, cualquiera podía inventar un permiso "aprobado" (las 4 firmas no se pueden
        // verificar sin un servidor) y con él escribir en el día de otra persona: ponerle una ausencia injustificada o
        // quitarle la suya. Pasar un permiso aprobado a nómina ya lo hace Admin al entrar al panel
        // (procesarPermisosAprobadosPendientes), así que esa rama no hace falta.
        allow create: if esAdmin() ||
          // Marcar entrada: el día nace como turno abierto, sin horas, con fecha de hoy y sin datos de Admin.
          (request.auth != null && escrituraColaboradorCoherente(cedula, fecha) &&
           request.resource.data.get('estado', null) == 'activo' && horasEnCero(request.resource.data) &&
           fechaCercanaAHoy(fecha) && permisoDelDiaSinCambio());

        allow update: if esAdmin() ||
          // "Entendido" en la decisión de RRHH sobre un permiso: solo ese campo, en cualquier día.
          (esColaboradorActivoAutenticado(cedula) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decisiones_vistas'])) ||
          (request.auth != null && escrituraColaboradorCoherente(cedula, fecha) && (
            // a) Turno abierto: almuerzo, salidas a permiso, cambio de obra y cierre (también la salida olvidada).
            (resource.data.get('estado', null) == 'activo' && sinCambio('entrada') && permisoDelDiaSinCambio() &&
             request.resource.data.get('estado', null) in ['activo', 'completado', 'requiere_revision_admin']) ||
            // b) Marcar entrada sobre un día que solo tenía un permiso o una ausencia, sin horas trabajadas.
            (!(resource.data.get('estado', null) in ['activo', 'requiere_revision_admin']) &&
             horasEnCero(resource.data) && horasEnCero(request.resource.data) &&
             request.resource.data.get('estado', null) == 'activo' && fechaCercanaAHoy(fecha) &&
             (permisoDelDiaSinCambio() || ausenciaQuitadaAlLlegar())) ||
            // c) Recalcular la semana: en un día cerrado solo cambian las horas, nunca el horario ni el estado.
            (resource.data.get('estado', null) == 'completado' && request.resource.data.get('estado', null) == 'completado' &&
             soloCamposDeRecalculo())
          ));

        allow delete: if esAdmin(); // el único botón de borrar un registro individual vive en el panel Admin
      }
    }

    // Copia "pública" liviana de empleados (solo nombre), usada para el buscador
    // por nombre al iniciar sesión. Solo admins la modifican (se sincroniza junto
    // con /empleados/ al agregar/importar colaboradores).
    match /empleados_publico/{cedula} {
      allow read: if true;
      allow create, delete: if esAdmin();
      // BUG CORREGIDO (soporte, 22/09): igual que en /empleados/, faltaba la rendija para que el
      // propio colaborador guarde aquí su authUid la primera vez que crea su PIN (o cuando se repara
      // uno que quedó a medias) — antes esto exigía esAdmin() para CUALQUIER escritura, así que ese
      // segundo guardado (el que hace posible que el buscador de nombres sepa que ya tiene PIN) también
      // quedaba rechazado con permission-denied.
      allow update: if esAdmin() ||
        (request.auth != null &&
         resource.data.get('authUid', null) == null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid']) &&
         request.resource.data.authUid == request.auth.uid);
    }

    // -------------------------------------------------------------------------
    // CATÁLOGOS: listas compartidas (clientes, obras, supervisores, festivos,
    // horarios por obra, correos de notificación, límites de permisos, etc.)
    // Todos las necesitan leer para que funcionen los formularios; solo un
    // admin puede cambiarlas.
    // -------------------------------------------------------------------------
    match /catalogos/{doc} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // -------------------------------------------------------------------------
    // RECORDATORIOS AL CELULAR: el identificador de notificaciones de cada
    // celular donde el colaborador aceptó los recordatorios. Solo el propio
    // colaborador agrega los suyos (no los lee ni toca nada más); el envío y el
    // registro de "ya enviado hoy" los hace scripts/recordatorios-turno.mjs con
    // la cuenta de servicio, que no pasa por estas reglas.
    // -------------------------------------------------------------------------
    match /push_tokens/{cedula} {
      allow read: if esAdmin();
      allow create: if esColaboradorActivoAutenticado(cedula) &&
        request.resource.data.keys().hasOnly(['tokens', 'actualizado_en']) &&
        request.resource.data.tokens is list && request.resource.data.tokens.size() <= 10;
      allow update: if esColaboradorActivoAutenticado(cedula) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens', 'actualizado_en']) &&
        request.resource.data.tokens is list && request.resource.data.tokens.size() <= 10;
      allow delete: if esAdmin();
    }

    // -------------------------------------------------------------------------
    // PERMISOS: se crean y se firman por enlace SIN que la persona inicie
    // sesión (así fue diseñado a propósito, para que cada firmante entre desde
    // su propio celular con solo el enlace). Por eso necesita quedar abierto.
    // Eliminar un permiso por error también está permitido desde la app sin
    // login (según se pidió); si quieres restringir esto solo a Admin, cambia
    // la línea de "delete" para exigir esAdmin().
    //
    // ENDURECIDO: antes "update" era 100% libre — cualquiera con el ID del
    // documento (no hace falta ni el enlace de firma) podía reescribir CUALQUIER
    // campo, incluidas las cédulas de los firmantes, el trabajador, las fechas,
    // etc. Ahora, sin ser Admin, una escritura solo se permite si el ÚNICO campo
    // de nivel superior que cambia es 'firmantes' (donde vive la firma de cada
    // persona) o 'estado' (que pasa a "aprobado" cuando ya firmaron los 4). No
    // protege campo por campo dentro de 'firmantes' — eso requeriría validar
    // identidad en un backend (Cloud Function), fuera del alcance de reglas de
    // Firestore — pero sí evita que alguien reescriba los datos base del
    // permiso (trabajador, cédula, tipo, fechas) sin ser Admin.
    // -------------------------------------------------------------------------
    // PRIVACIDAD (30/10): abrir UN permiso por su id sigue abierto, porque así funcionan los enlaces de firma y la
    // constancia (el id son 20 caracteres al azar: no se puede adivinar). LISTAR permisos: solo Admin, o el colaborador
    // los suyos (la consulta debe filtrar por su cédula).
    match /permisos/{id} {
      allow get: if true;
      allow list: if esAdmin() || esDuenoDe(resource.data.get('trabajador_cedula', null));
      // ENDURECIDO (ronda 5, parte 2): un permiso nace SIEMPRE en un estado distinto de 'aprobado'
      // (típicamente 'pendiente') — nadie puede crear uno que ya llegue "pre-aprobado".
      // ENDURECIDO (auditoría nov-2026, hallazgo 4): el tipo tiene que ser uno del catálogo de permisos (PERMISOS_CATALOGO en
      // index.html). Así nadie puede crear un "permiso" de tipo "Ausencia injustificada" para que Admin lo pase a nómina.
      allow create: if request.resource.data.estado != 'aprobado' &&
        (esAdmin() || request.resource.data.get('tipo', '') in tiposDePermisoValidos());
      allow update: if esAdmin() ||
        // aprobado_en: lo marca la última firma, para que Admin pase el permiso a nómina si quien firmó no tenía sesión.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firmantes', 'estado', 'aprobado_en']) &&
         (request.resource.data.estado != 'aprobado' || permisoTieneLas4Firmas()));
      // ENDURECIDO: borrar una solicitud exige Admin. Antes era "if true": cualquier colaborador (o cualquiera con las
      // credenciales públicas de Firebase) podía borrar solicitudes de permiso de los demás desde el Historial.
      allow delete: if esAdmin();
    }

    // -------------------------------------------------------------------------
    // AVISOS DE SEMANA INCUMPLIDA: marcador que crea el propio celular del
    // colaborador (sin login real, igual que "registros") para no enviar dos
    // veces el mismo correo de "esta semana no alcanzó las 42h" a RRHH. Solo
    // Admin puede leerlos y nadie puede modificarlos o borrarlos (registro de
    // qué avisos ya se mandaron).
    // -------------------------------------------------------------------------
    match /avisos_semana_incumplida/{id} {
      allow create: if true;
      allow read: if esAdmin();
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // DESPRENDIBLES DE PAGO: igual que permisos, se crean y se firman por enlace
    // sin que la persona inicie sesión (cada colaborador firma desde su propio
    // celular). El ARCHIVO del desprendible en sí NO se guarda aquí — solo el
    // enlace a Google Drive (o donde lo suban) y la firma del colaborador.
    // -------------------------------------------------------------------------
    // ENDURECIDO: igual que en 'permisos', "update" era 100% libre antes. Ahora, sin ser Admin,
    // solo se permite si los campos que cambian son EXACTAMENTE los que pone la firma remota
    // (firmado_por, firma, estado, firmado_en) — así no se puede reescribir el monto, el período,
    // la cédula del trabajador ni el enlace al documento sin iniciar sesión de Admin.
    // PRIVACIDAD (30/10): igual que permisos: uno por su enlace sí; listar, solo Admin o el propio colaborador. Crear
    // desprendibles es tarea de Admin (antes cualquiera podía crear uno).
    match /desprendibles/{id} {
      allow get: if true;
      allow list: if esAdmin() || esDuenoDe(resource.data.get('trabajador_cedula', null));
      allow create: if esAdmin();
      allow update: if esAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['firmado_por', 'firma', 'estado', 'firmado_en']);
      allow delete: if esAdmin();
    }

    // -------------------------------------------------------------------------
    // INCAPACIDADES: el formulario para crearlas y el botón de borrar viven SOLO
    // en el panel Admin, así que crear/borrar exige esAdmin(). Pero la lectura
    // debe quedar abierta: cada colaborador, sin iniciar sesión, consulta si
    // tiene una incapacidad activa al entrar a "Mi Tarjeta" (y así bloquear su
    // fichaje). Además, la función que avisa por correo cuando una incapacidad
    // está por terminar corre en el arranque de CUALQUIER sesión (incluida la
    // de un colaborador) y necesita poder marcar 'alerta_ultimo_dia_enviada' en
    // true; por eso, sin ser admin, solo se permite tocar ese único campo.
    // -------------------------------------------------------------------------
    // PRIVACIDAD (30/10): tipo y diagnóstico médico: solo Admin o el colaborador al que pertenece.
    match /incapacidades/{id} {
      allow read: if esAdmin() || esDuenoDe(resource.data.get('trabajador_cedula', null));
      allow create, delete: if esAdmin();
      allow update: if esAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['alerta_ultimo_dia_enviada']);
    }

    // -------------------------------------------------------------------------
    // AUDITORÍA: cualquiera puede agregar una entrada (para que quede rastro
    // incluso de acciones hechas sin login, como eliminar un permiso desde la
    // pestaña Permisos), pero solo un Admin puede LEER el registro completo, y
    // nadie puede modificar o borrar entradas ya escritas (para que no se pueda
    // "limpiar el rastro").
    // -------------------------------------------------------------------------
    match /auditoria/{id} {
      allow create: if true;
      allow read: if esAdmin();
      allow update, delete: if false;
    }
  }
}
